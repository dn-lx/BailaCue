{
  "expo": {
    "name": "BailaCue",
    "slug": "bailacue",
    "version": "0.2.1",
    "scheme": "bailacue",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bailacue.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.bailacue.mobile",
      "versionCode": 3,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#321D36"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#321D36",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a dance video to add to your private library.",
          "cameraPermission": "Record your dance practice when you choose Record.",
          "microphonePermission": "Include audio in your practice recording."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save your exported dance clips to Photos.",
          "savePhotosPermission": "Save the new trimmed video you choose to export.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private BailaCue library with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
