# Public app identifiers only. Each user still signs in to their own storage account.
# Android Google OAuth registration uses package name + APK certificate SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_DROPBOX_APP_KEY=
# Deploy the scoped API first; never put a shared Me+ Auth JWT or service key in the app.
EXPO_PUBLIC_BAILACUE_API_URL=
# Server-only optional CORS origin is configured as an Edge Function secret, not here:
# BAILACUE_WEB_ORIGIN (exact browser preview origin, no wildcard)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are server runtime variables.

# Optional public YouTube Data API v3 key for complete playlist pagination.
# Can instead be entered under YouTube → Advanced setup on each device.
EXPO_PUBLIC_YOUTUBE_API_KEY=
