# Reserved for milestone 2. This local-first build does not read these values yet.
# Public client config only; never add a service-role key or OAuth client secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
# OAuth client IDs are platform-specific. Secrets belong on the backend.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_DROPBOX_APP_KEY=
